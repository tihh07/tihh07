{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/**)",
      "Glob(/**)",
      "Grep(/**)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(diff:*)",
      "Bash(bash -n:*)",
      "Bash(bash plugins/fundacao/hooks/test-guard-push.sh)",
      "Bash(bash plugins/fundacao/hooks/test-hooks-presentes.sh)"
    ],
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/credentials.json)",
      "Read(/**/secrets.json)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/plugins/fundacao/hooks/guard-push.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/plugins/fundacao/hooks/hooks-presentes.sh",
            "timeout": 10,
            "statusMessage": "Conferindo se os hooks declarados existem..."
          }
        ]
      }
    ]
  }
}
